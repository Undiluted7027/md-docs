# Local Supabase infrastructure. Keep this file aligned with the output of
# `bunx supabase status`; application-specific settings live under apps/*.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:YOUR_PORT/postgres
SUPABASE_URL=http://127.0.0.1:YOUR_API_PORT
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
SUPABASE_SECRET_KEY=your-local-secret-key
