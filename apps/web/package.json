{
  "name": "@md-docs/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run typecheck && bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "typecheck": "bun run --bun tsc --project tsconfig.json && bun run --bun tsc --project tsconfig.vite.json"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@fontsource-variable/manrope": "5.3.0",
    "@hocuspocus/provider": "4.6.0",
    "@md-docs/protocol": "workspace:*",
    "@t3-oss/env-core": "0.13.11",
    "motion": "13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2"
  }
}
