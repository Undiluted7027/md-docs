{
  "name": "@md-docs/server",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun run --bun tsc --project tsconfig.json",
    "dev": "LOG_PRETTY=true bun --watch src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "db:generate": "bun run --bun drizzle-kit generate",
    "db:migrate": "bun run --bun drizzle-kit migrate"
  },
  "devDependencies": {
    "@hocuspocus/provider": "3.4.4",
    "@types/bun": "1.4.1",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "@hocuspocus/server": "3.4.4",
    "@t3-oss/env-core": "0.13.11",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "postgres": "3.4.9",
    "yjs": "13.6.32",
    "zod": "4.5.4"
  }
}
