# From `bunx supabase status` (local Postgres connection string).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:YOUR_PORT/postgres
# Network interface for Fastify. Render requires 0.0.0.0; keep loopback locally.
HOST=127.0.0.1
# Server HTTP port.
PORT=3001
# Browser origin allowed to use the HTTP API and collaboration WebSocket.
WEB_ORIGIN=http://localhost:5173
# Human-readable console logs instead of JSON. `bun dev` sets this automatically.
LOG_PRETTY=false
# Set to "production" in deployment to hide internal 5xx error messages from
# client responses.
# NODE_ENV=production
